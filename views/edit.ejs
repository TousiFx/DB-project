<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Listing - Explore Stays</title>
    <link rel="stylesheet" href="/edit.css" />
  </head>
  <body>
    <div class="form-container">
      <a href="/listing/<%= listing._id %>/page" class="back-link"
        >&larr; Back to Listing</a
      >

      <div class="form-header">
        <h1>Edit Your Listing</h1>
        <p>Update the details below to modify your stay.</p>
      </div>

      <form
        method="POST"
        action="/listing/<%= listing._id %>?_method=PUT"
        class="listing-form"
      >
        <div class="form-group">
          <label for="title">Property Title *</label>
          <input
            type="text"
            id="title"
            name="listing[title]"
            value="<%= listing.title %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="listing[description]" rows="4">
<%= listing.description %></textarea
          >
        </div>

        <div class="form-group">
          <label for="image">Image URL</label>
          <input
            type="url"
            id="image"
            name="listing"
            value="<%= listing.image %>"
          />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price">Price per Night (₹) *</label>
            <input
              type="number"
              id="price"
              name="listing[price]"
              min="0"
              value="<%= listing.price %>"
              required
            />
          </div>

          <div class="form-group">
            <label for="country">Country *</label>
            <input
              type="text"
              id="country"
              name="listing[country]"
              value="<%= listing.country %>"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="location">Location / City *</label>
          <input
            type="text"
            id="location"
            name="listing[location]"
            value="<%= listing.location %>"
            required
          />
        </div>

        <button type="submit" class="submit-btn">Save Changes</button>
      </form>
    </div>
  </body>
</html>
