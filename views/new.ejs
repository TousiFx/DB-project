<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Listing - Explore Stays</title>
    <link rel="stylesheet" href="/new.css" />
  </head>
  <body>
    <div class="form-container">
      <a href="/listing" class="back-link">&larr; Back to Explore Stays</a>

      <div class="form-header">
        <h1>Create a New Listing</h1>
        <p>Fill in the details below to list a stay.</p>
      </div>

      <form method="POST" action="/listing" class="listing-form">
        <div class="form-group">
          <label for="title">Property Title *</label>
          <input
            type="text"
            id="title"
            name="listing[title]"
            placeholder="e.g., Sunset Cliffside Villa"
            required
          />
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea
            id="description"
            name="listing[description]"
            rows="4"
            placeholder="Describe the vibe, amenities, and surroundings..."
          ></textarea>
        </div>

        <div class="form-group">
          <label for="image">Image URL</label>
          <input
            type="url"
            id="image"
            name="listing[image]"
            placeholder="https://example.com (Leave blank for default)"
          />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price">Price per Night (₹) *</label>
            <input
              type="number"
              id="price"
              name="listing[price]"
              min="0"
              placeholder="e.g., 4500"
              required
            />
          </div>

          <div class="form-group">
            <label for="country">Country *</label>
            <input
              type="text"
              id="country"
              name="listing[country]"
              placeholder="e.g., India"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="location">Location / City *</label>
          <input
            type="text"
            id="location"
            name="listing[location]"
            placeholder="e.g., Goa"
            required
          />
        </div>

        <button type="submit" class="submit-btn">Publish Listing</button>
      </form>
    </div>
  </body>
</html>
